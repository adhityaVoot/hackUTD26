VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=tandem-hackutd

# Public OIDC configuration; never add a client secret to VITE_ variables.
VITE_SPACETIMEAUTH_CLIENT_ID=client_034tn4mKpPebmrzFj9lznr
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Leave empty to use window.location.origin + /callback for either registered hostname.
VITE_SPACETIMEAUTH_REDIRECT_URI=
# Confirm the backend expense convention before enabling purchase submission: -1 or 1.
VITE_PURCHASE_EXPENSE_SIGN=
# Optional trusted origin if the share-token redemption service runs elsewhere.
VITE_SHARE_REDEEM_ORIGIN=
